from pathlib import Path
import hashlib
import json
import subprocess

base = Path('/home/leo/Desktop/Tuki')
installer = base / 'aplicar-roles-auth0.mjs'
frontend = base / 'KIMANI-Frontend-v2'

current_hash = 'c40da16121c96ca532a3c4026a00c2a65cb0f2c13a6c2a86f6fc42a46a85ec87'
patched_hash = '9834ea208271d4012929aa76570a00e0a4e7ca7c61203977d4cdd568595aee2f'
sha = lambda data: hashlib.sha256(data).hexdigest()

source = installer.read_text()
start = source.index('const sources = ') + len('const sources = ')
sources, length = json.JSONDecoder().raw_decode(source[start:])
record = next(
    item for item in sources['sdk']
    if item['path'] == 'src/websocket/client.ts'
)

actual = frontend / 'external/revolt.js/src/websocket/client.ts'
if sha(actual.read_bytes()) not in (current_hash, patched_hash):
    raise SystemExit('El archivo ha vuelto a cambiar. No se modifico nada.')

if record['before'] != current_hash:
    if record['before'] != '5fdf17b00ffe01e6ab94fd02a92c3717bcea511024dd4d6ce618f8f3672cca94':
        raise SystemExit('Instalador no reconocido. No se modifico nada.')

    content = record['content']
    first = content.index('                                        // Ids are ULIDs')
    last = content.index(
        '\n                                        if (',
        content.index('                                            message._id;\n', first),
    )
    replacement = '\n'.join([
        '                                        // A message finished on the slow path',
        '                                        // must not move the channel pointer',
        '                                        // back behind a newer one.',
        '                                        channel.advanceLastMessageId(',
        '                                            message._id,',
        '                                        );',
        '',
    ])
    content = content[:first] + replacement + content[last:]

    if sha(content.encode()) != patched_hash:
        raise SystemExit('La adaptacion no coincide. No se modifico nada.')

    record.update(before=current_hash, after=patched_hash, content=content)
    installer.write_text(
        source[:start]
        + json.dumps(sources, ensure_ascii=False, indent=2)
        + source[start + length:]
    )
    print('Instalador adaptado. Repositorios sin modificar.')
else:
    print('El instalador ya estaba adaptado.')

for repo, root in [
    ('sdk', frontend / 'external/revolt.js'),
    ('frontend', frontend),
]:
    subprocess.run([
        'node', str(installer),
        '--repo', repo, '--root', str(root), '--check',
    ], check=True)
PY